-- SHIFT LOCK (GLOBAL)
-----------------------------------------------------
local shiftEnabled = false
UIS.InputBegan:Connect(function(i,g)
    if g then return end
    if i.KeyCode == Enum.KeyCode.LeftShift then
        shiftEnabled = not shiftEnabled
        pcall(function()
            player.DevEnableMouseLock = shiftEnabled
        end)
    end
end)

