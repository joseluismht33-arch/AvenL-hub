-----------------------------------------------------
-- LOADSTRING SAFE
-----------------------------------------------------
local function fastLoad(url)
    local ok, src = pcall(function()
        return game:HttpGet(url)
    end)
    if not ok or not src then
        warn("[AvenL] Falha ao carregar:", url)
        return
    end
    local run, err = pcall(function()
        loadstring(src)()
    end)
    if not run then
        warn("[AvenL] Erro:", err)
    end
end

