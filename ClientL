-- FUNÇÃO DE CARREGAMENTO
-------------------------
local function carregarRapido(url)
    local sucessoHttp, codigo = pcall(function()
        return game:HttpGet(url)
    end)

    if not sucessoHttp or not codigo then
        warn("[AvenL Hub] Falha ao baixar o script.")
        return
    end

    local sucessoExec, erro = pcall(function()
        loadstring(codigo)()
    end)

    if not sucessoExec then
        warn("[AvenL Hub] Erro ao executar o script:", erro)
    end
end

