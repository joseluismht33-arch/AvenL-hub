local function fakeAnim()
    local char = player.Character
    if not char then return end
    for _,v in pairs(char:GetDescendants()) do
        if v:IsA("Motor6D") then
            v.Transform = CFrame.Angles(math.rad(15),0,0)
        end
    end
end

